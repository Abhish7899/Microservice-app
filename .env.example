# ==========================================
# Environment Variables Template
# Copy this file to .env for local development
# NEVER commit the real .env file to git
# ==========================================

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tasks_db
POSTGRES_PORT=5432

# task-service Configuration
TASK_SERVICE_PORT=3000
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/tasks_db
NODE_ENV=production

# stats-service Configuration
STATS_SERVICE_PORT=4000
TASK_SERVICE_URL=http://task-service:3000
